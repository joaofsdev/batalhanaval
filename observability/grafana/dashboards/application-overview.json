        "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "blue", "value": 1}] }, "unit": "short" },
        "overrides": []
      },
      "gridPos": { "h": 6, "w": 5, "x": 0, "y": 1 },
      "id": 51,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "value_and_name" },
      "title": "Players Online",
      "targets": [
