{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 200,
      "title": "Slow Requests",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisBorderShow": false, "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "id": 1,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "title": "Slow Requests Rate",
      "targets": [
        {
          "expr": "rate(http_server_requests_slow_total{application=\"batalhanaval-api\"}[$__rate_interval])",
          "legendFormat": "Slow Requests/s"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisBorderShow": false, "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "id": 2,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "title": "Slowest Endpoints (p99 Response Time)",
      "targets": [
        {
          "expr": "topk(10, histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"batalhanaval-api\"}[$__rate_interval])) by (le, uri, method)))",
          "legendFormat": "{{method}} {{uri}}"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{"color": "green", "value": null}, {"color": "yellow", "value": 0.5}, {"color": "red", "value": 1}] },
          "unit": "s",
          "custom": { "align": "auto", "displayMode": "color-background-solid" }
        },
        "overrides": []
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 9 },
      "id": 3,
      "options": { "sortBy": [{ "displayName": "p99", "desc": true }] },
      "title": "Endpoint Performance Table",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(http_server_requests_seconds_bucket{application=\"batalhanaval-api\"}[$__rate_interval])) by (le, uri, method))",
          "legendFormat": "{{method}} {{uri}}",
          "format": "table",
          "instant": true,
          "refId": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{application=\"batalhanaval-api\"}[$__rate_interval])) by (le, uri, method))",
          "legendFormat": "{{method}} {{uri}}",
          "format": "table",
          "instant": true,
          "refId": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{application=\"batalhanaval-api\"}[$__rate_interval])) by (le, uri, method))",
          "legendFormat": "{{method}} {{uri}}",
          "format": "table",
          "instant": true,
          "refId": "p99"
        }
      ],
      "type": "table",
      "transformations": [
        { "id": "merge" },
        { "id": "organize", "options": { "excludeByName": { "Time": true, "le": true }, "renameByName": { "Value #p50": "p50", "Value #p95": "p95", "Value #p99": "p99" } } }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 19 },
      "id": 201,
      "title": "Slow Queries",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisBorderShow": false, "drawStyle": "bars", "fillOpacity": 80, "lineWidth": 1 },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "id": 4,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "title": "Slow Queries Rate",
      "targets": [
        {
          "expr": "rate(db_query_slow_total{application=\"batalhanaval-api\"}[$__rate_interval])",
          "legendFormat": "Slow Queries/s"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "axisBorderShow": false, "drawStyle": "line", "fillOpacity": 20, "lineWidth": 2 },
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "title": "Query Duration Distribution",
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(db_query_duration_seconds_bucket{application=\"batalhanaval-api\"}[$__rate_interval])) by (le))",
          "legendFormat": "p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(db_query_duration_seconds_bucket{application=\"batalhanaval-api\"}[$__rate_interval])) by (le))",
          "legendFormat": "p95"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(db_query_duration_seconds_bucket{application=\"batalhanaval-api\"}[$__rate_interval])) by (le))",
          "legendFormat": "p99"
        }
      ],
      "type": "timeseries"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 28 },
      "id": 202,
      "title": "Distributed Traces",
      "type": "row"
    },
    {
      "datasource": { "type": "tempo", "uid": "tempo" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 29 },
      "id": 6,
      "options": {
        "query": { "serviceName": "batalhanaval-api", "limit": 20 }
      },
      "title": "Recent Traces (search in Tempo)",
      "type": "traces"
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "id": 203,
      "title": "SLO Compliance",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 90}, {"color": "green", "value": 99}] },
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 42 },
      "id": 7,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto" },
      "title": "Requests < 200ms (%)",
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_bucket{application=\"batalhanaval-api\", le=\"0.2\"}[$__range])) / sum(increase(http_server_requests_seconds_count{application=\"batalhanaval-api\"}[$__range])) * 100",
          "legendFormat": "% < 200ms"
        }
      ],
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 90}, {"color": "green", "value": 99}] },
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 42 },
      "id": 8,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto" },
      "title": "Requests < 500ms (%)",
      "targets": [
        {
          "expr": "sum(increase(http_server_requests_seconds_bucket{application=\"batalhanaval-api\", le=\"0.5\"}[$__range])) / sum(increase(http_server_requests_seconds_count{application=\"batalhanaval-api\"}[$__range])) * 100",
          "legendFormat": "% < 500ms"
        }
      ],
      "type": "gauge"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "steps": [{"color": "red", "value": null}, {"color": "yellow", "value": 95}, {"color": "green", "value": 99}] },
          "unit": "percent",
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 42 },
      "id": 9,
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto" },
      "title": "Success Rate (non-5xx) %",
      "targets": [
        {
          "expr": "(1 - sum(increase(http_server_requests_seconds_count{application=\"batalhanaval-api\", status=~\"5..\"}[$__range])) / sum(increase(http_server_requests_seconds_count{application=\"batalhanaval-api\"}[$__range]))) * 100",
          "legendFormat": "Success Rate"
        }
      ],
      "type": "gauge"
    }
  ],
  "schemaVersion": 39,
  "tags": ["batalhanaval", "performance", "traces"],
  "templating": {
    "list": [
      {
        "current": { "selected": false, "text": "Prometheus", "value": "prometheus" },
        "hide": 0,
        "includeAll": false,
        "name": "DS_PROMETHEUS",
        "query": "prometheus",
        "type": "datasource"
      }
    ]
  },
  "time": { "from": "now-30m", "to": "now" },
  "title": "Batalha Naval - Performance & Traces",
  "uid": "batalhanaval-performance",
  "version": 1
}
